---
import Layout from '../layouts/Layout.astro';
import WorldMap from '../components/WorldMap.astro';
import IconLink from '../components/IconLink.astro';
import { profile } from '../lib/data.js';
const ig = profile.links.find(l => l.icon === 'instagram.com');
---
<Layout title="Travel" current="travel">
<section><div class="wrap">
  <div class="page-head">
    <p class="eyebrow">Travel</p>
    <h1>Places I've been</h1>
    <p>Countries I've visited, for work and with friends and family. Click one to see it up close.</p>
    {ig && <div class="iconlinks"><IconLink label="More photos on Instagram" href={ig.url} icon="instagram.com" /></div>}
  </div>
  <WorldMap />
</div></section>
</Layout>
