---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import { projects, linkify } from '../lib/data.js';
---
<Layout title="Data & ML" current="projects">
<section><div class="wrap">
  <div class="page-head">
    <p class="eyebrow">Data &amp; ML</p>
    <h1>Research problems, written as data problems</h1>
    <p>{projects.intro}</p>
  </div>
  <div class="grid">
    {projects.cases.map(c => (
      <article class="card case">
        {c.image && <Pic ref={c.image} />}
        <h3>{c.title}</h3>
        <dl><dt>Problem</dt><dd>{c.problem}</dd><dt>Method</dt><dd>{c.method}</dd><dt>Output</dt><dd>{c.output}</dd></dl>
        <div class="tags">{c.tags.map(t => <span class="tag">{t}</span>)}</div>
        {c.repo ? <a class="ilink" href={c.repo} target="_blank" rel="noopener"><img src="https://www.google.com/s2/favicons?domain=github.com&sz=64" alt="" width="18" height="18" /><span>Code on GitHub</span><span class="ext">↗</span></a>
               : c.todo && <p class="todo">{c.todo}</p>}
      </article>))}
  </div>
  <h2 class="sec">Toolkit</h2>
  <div class="skills">
    {projects.toolkit.map(t => <div class="card"><h3>{t.title}</h3><div class="tags">{t.tags.map(x => <span class="tag">{x}</span>)}</div></div>)}
    <div class="card"><h3>Business training</h3><p set:html={linkify(projects.business)} /></div>
  </div>
</div></section>
</Layout>
