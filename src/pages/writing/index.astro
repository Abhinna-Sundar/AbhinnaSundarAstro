---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/data.js';
const posts = (await getCollection('blog', p => !p.data.draft)).sort((a, b) => b.data.date - a.data.date);
const fmt = d => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Layout title="Writing" current="writing">
<section><div class="wrap">
  <div class="page-head"><p class="eyebrow">Writing</p><h1>Notes and guides</h1><p>Things I wish someone had told me, mostly about astronomy careers, data and research life.</p></div>
  {posts.map(p => (
    <article class="post">
      <a href={url(`/writing/${p.id}/`)}><Pic ref={p.data.cover} /></a>
      <div>
        <p class="mono" style="color:var(--muted);font-size:13px">{fmt(p.data.date)}</p>
        <h3 style="margin-top:6px"><a href={url(`/writing/${p.id}/`)} style="text-decoration:none">{p.data.title}</a></h3>
        <p>{p.data.description}</p>
        <div class="tags" style="margin-top:12px">{p.data.tags.map(t => <span class="tag">{t}</span>)}</div>
      </div>
    </article>))}
</div></section>
</Layout>
