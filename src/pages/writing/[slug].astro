---
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/data.js';
export async function getStaticPaths() {
  return (await getCollection('blog', p => !p.data.draft)).map(p => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = d => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title={post.data.title} description={post.data.description} current="writing">
<section><div class="wrap article">
  <p class="eyebrow"><a href={url('/writing/')} style="text-decoration:none">← Writing</a></p>
  <h1 style="font-size:clamp(28px,4vw,42px);margin:14px 0 8px">{post.data.title}</h1>
  <p class="mono" style="color:var(--muted);font-size:13px">{fmt(post.data.date)}{post.data.updated && ` · updated ${fmt(post.data.updated)}`}</p>
  {post.data.cover && <Pic ref={post.data.cover} class="banner" />}
  <div class="prose" style="margin-top:24px"><Content /></div>
</div></section>
</Layout>
