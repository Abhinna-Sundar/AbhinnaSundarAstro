---
// A single clickable chip: the website's own small icon + label, opens in a new tab.
const { label, href, icon } = Astro.props;
const fav = icon ? `https://www.google.com/s2/favicons?domain=${icon}&sz=64` : null;
---
<a class="ilink" href={href} target="_blank" rel="noopener">
  {fav && <img src={fav} alt="" width="18" height="18" loading="lazy" />}
  <span>{label}</span><span class="ext">↗</span>
</a>
