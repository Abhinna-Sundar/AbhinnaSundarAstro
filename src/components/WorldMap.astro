---
import { travel, url } from '../lib/data.js';
// Only countries are shown. "places" in travel.yaml are optional: they are used only to tell the
// mainland from far-away territories (e.g. France vs. French Guiana) and for photos.
const T = travel.countries.map(c => ({
  id: c.id, iso: c.iso, name: c.name, continent: c.continent || '', note: c.note || '',
  places: (c.places || []).map(p => ({ lat: p.lat, lon: p.lon, name: p.name })),
  photos: [...(c.photos || []), ...(c.places || []).flatMap(p => p.photos || [])].map(url),
}));
---
<div class="travel">
  <div class="mapbox" id="mapbox" data-src={url('/data/countries.json')} data-travel={JSON.stringify(T)} data-next={travel.next || ''}><svg id="map" role="img" aria-label="World map of visited countries"></svg><button class="iconbtn" id="mapBack" hidden>← World</button></div>
  <aside class="panel" id="panel" aria-live="polite"></aside>
</div>
<div class="tstats" id="tstats"></div>
<div class="flags" id="flags"></div>
<script>
import * as d3 from 'd3';
import * as topojson from 'topojson-client';
(function(){
const box0=document.getElementById('mapbox');
const TRAVEL=JSON.parse(box0.dataset.travel); const NEXT=box0.dataset.next;

// ---- Flags, drawn in a 1×1 box (stretched over each country). Add a country: ISO code → stripes. ----
const nordic=(bg,cr,inner)=>({bg,x:`<rect x=".3" y="0" width=".14" height="1" fill="${cr}"/><rect x="0" y=".42" width="1" height=".16" fill="${cr}"/>`+(inner?`<rect x=".335" y="0" width=".07" height="1" fill="${inner}"/><rect x="0" y=".46" width="1" height=".08" fill="${inner}"/>`:'')});
const FLAGS={
  DE:{h:['#000','#DD0000','#FFCE00']},
  IN:{h:['#FF9933','#FFFFFF','#138808'],x:'<ellipse cx=".5" cy=".5" rx=".055" ry=".085" fill="none" stroke="#06038D" stroke-width=".014"/>'},
  US:{h:Array.from({length:13},(_,i)=>i%2?'#FFFFFF':'#B22234'),x:'<rect width=".4" height=".5385" fill="#3C3B6E"/>'},
  ES:{h:['#AA151B','#F1BF00','#AA151B'],w:[1,2,1]},
  BE:{v:['#000','#FDDA24','#EF3340']},
  CH:{bg:'#DA291C',x:'<rect x=".42" y=".2" width=".16" height=".6" fill="#fff"/><rect x=".25" y=".4" width=".5" height=".2" fill="#fff"/>'},
  IE:{v:['#169B62','#FFFFFF','#FF883E']},
  GR:{h:Array.from({length:9},(_,i)=>i%2?'#FFFFFF':'#0D5EAF'),x:'<rect width=".37" height=".5556" fill="#0D5EAF"/><rect x=".148" width=".074" height=".5556" fill="#fff"/><rect y=".2222" width=".37" height=".1111" fill="#fff"/>'},
  IT:{v:['#009246','#FFFFFF','#CE2B37']},
  CZ:{h:['#FFFFFF','#D7141A'],x:'<polygon points="0,0 .5,.5 0,1" fill="#11457E"/>'},
  LU:{h:['#EA141D','#FFFFFF','#51ADDA']},
  FR:{v:['#0055A4','#FFFFFF','#EF4135']},
  SI:{h:['#FFFFFF','#005DA4','#ED1C24']},
  NL:{h:['#AE1C28','#FFFFFF','#21468B']},
  SK:{h:['#FFFFFF','#0B4EA2','#EE1C25']},
  AT:{h:['#C8102E','#FFFFFF','#C8102E']},
  MT:{v:['#FFFFFF','#CF142B']},
  DK:nordic('#C8102E','#FFFFFF'),
  SE:nordic('#006AA7','#FECC00'),
  NO:nordic('#BA0C2F','#FFFFFF','#00205B'),
  FI:nordic('#FFFFFF','#002F6C'),
  PL:{h:['#FFFFFF','#DC143C']},
  PT:{v:['#046A38','#DA291C'],w:[2,3]},
  HU:{h:['#CD2A3E','#FFFFFF','#436F4D']},
  RO:{v:['#002B7F','#FCD116','#CE1126']},
  BG:{h:['#FFFFFF','#00966E','#D62612']},
  EE:{h:['#0072CE','#000000','#FFFFFF']},
  LT:{h:['#FDB913','#006A44','#C1272D']},
  LV:{h:['#9E3039','#FFFFFF','#9E3039'],w:[2,1,2]},
  JP:{bg:'#FFFFFF',x:'<ellipse cx=".5" cy=".5" rx=".2" ry=".3" fill="#BC002D"/>'},
  CL:{h:['#FFFFFF','#D52B1E'],x:'<rect width=".33" height=".5" fill="#0039A6"/>'},
};
function flagEls(iso,onMap){
  const f=FLAGS[iso]; if(!f) return '<rect width="1" height="1" fill="#cf3439"/>';
  let s=f.bg?`<rect width="1" height="1" fill="${f.bg}"/>`:'';
  for(const dir of ['h','v']){ if(!f[dir]) continue; const w=f.w||f[dir].map(()=>1), tot=w.reduce((a,b)=>a+b,0); let o=0;
    f[dir].forEach((c,i)=>{const a=(o/tot).toFixed(4), b=(w[i]/tot+.002).toFixed(4); s+=dir==='h'?`<rect y="${a}" width="1" height="${b}" fill="${c}"/>`:`<rect x="${a}" width="${b}" height="1" fill="${c}"/>`; o+=w[i];}); }
  return s+(onMap&&iso==='IN'?'':(f.x||''));  // India's wheel looks distorted when stretched over the map
}
const flagSVG=(iso,w,h)=>`<svg class="fl" viewBox="0 0 1 1" preserveAspectRatio="none" width="${w}" height="${h}" aria-hidden="true">${flagEls(iso)}</svg>`;

const mapState={ready:false};
const panel=document.getElementById('panel');
function worldPanel(){
  const conts=[...new Set(TRAVEL.map(c=>c.continent).filter(Boolean))];
  panel.innerHTML=`<p class="eyebrow">Overview</p><h3>${TRAVEL.length} countries</h3><p style="color:var(--muted)">${conts.join(' · ')}</p><p style="color:var(--muted)">Click a country on the map or a flag below.</p>${NEXT?`<p class="eyebrow" style="margin-top:6px">Next stop</p><p>${NEXT}</p>`:''}`;
}
function countryPanel(c){
  panel.innerHTML=`${flagSVG(c.iso,96,64)}<h3>${c.name}</h3>${c.continent?`<p class="eyebrow">${c.continent}</p>`:''}${c.note?`<p>${c.note}</p>`:''}${c.photos.map(s=>`<figure class="pic" style="aspect-ratio:3/2"><img src="${s}" alt="${c.name}" loading="lazy"></figure>`).join('')}`;
}
function initMap(){
  if(mapState.started) return; mapState.started=true;
  worldPanel();
  const conts=new Set(TRAVEL.map(c=>c.continent).filter(Boolean)).size;
  document.getElementById('tstats').innerHTML=`<div><div class="n">${TRAVEL.length}</div><div class="l">countries</div></div><div><div class="n">${conts}</div><div class="l">continents</div></div>`;
  document.getElementById('flags').innerHTML=TRAVEL.map(c=>`<button data-id="${c.id}">${flagSVG(c.iso,30,20)}<span><b style="display:block;font-weight:600">${c.name}</b><span class="c">${c.continent||c.iso}</span></span></button>`).join('');
  document.querySelectorAll('#flags button').forEach(b=>b.addEventListener('click',()=>{zoomTo(b.dataset.id);document.getElementById('mapbox').scrollIntoView({behavior:'smooth',block:'center'})}));
  fetch(box0.dataset.src).then(r=>r.json()).then(topo=>{
    const box=document.getElementById('mapbox'); const w=box.clientWidth,h=box.clientHeight;
    const svg=d3.select('#map').attr('viewBox',`0 0 ${w} ${h}`);
    const feats=topojson.feature(topo,topo.objects.countries).features.filter(f=>f.properties.name!=='Antarctica');
    const projection=d3.geoNaturalEarth1().fitExtent([[8,8],[w-8,h-8]],{type:'FeatureCollection',features:feats});
    const path=d3.geoPath(projection);
    // one flag pattern per visited country
    svg.append('defs').html(TRAVEL.map(c=>`<pattern id="flag-${c.iso}" patternUnits="objectBoundingBox" patternContentUnits="objectBoundingBox" width="1" height="1">${flagEls(c.iso,true)}</pattern>`).join(''));
    const g=svg.append('g'); const visited=new Set(TRAVEL.map(c=>c.id));
    // Mainland only: parts within ~1500 km of a place you listed (no places listed → whole country)
    const NEAR=1500/6371, parts=[];
    for(const f of feats){
      if(!visited.has(f.id)){parts.push({f,on:false});continue;}
      const c=TRAVEL.find(t=>t.id===f.id);
      const polys=f.geometry.type==='MultiPolygon'?f.geometry.coordinates:[f.geometry.coordinates];
      const near=[],far=[];
      for(const poly of polys){const cen=d3.geoCentroid({type:'Polygon',coordinates:poly});
        (!c.places.length||c.places.some(p=>d3.geoDistance(cen,[p.lon,p.lat])<NEAR)?near:far).push(poly);}
      if(near.length) parts.push({f:{type:'Feature',id:f.id,properties:f.properties,geometry:{type:'MultiPolygon',coordinates:near}},on:true,iso:c.iso});
      if(far.length) parts.push({f:{type:'Feature',id:f.id+'-far',properties:f.properties,geometry:{type:'MultiPolygon',coordinates:far}},on:false});
    }
    parts.sort((a,b)=>a.on-b.on); // visited countries drawn last so their outline sits on top
    g.selectAll('path').data(parts).join('path').attr('d',d=>path(d.f)).attr('class',d=>'country'+(d.on?' on':''))
      .attr('style',d=>d.on?`fill:url(#flag-${d.iso})`:null)
      .on('click',(e,d)=>{if(d.on) zoomTo(d.f.id);})
      .append('title').text(d=>d.on?d.f.properties.name:'');
    const zoom=d3.zoom().scaleExtent([1,160]).on('zoom',e=>g.attr('transform',e.transform));
    svg.call(zoom).on('wheel.zoom',null);
    Object.assign(mapState,{ready:true,svg,g,feats:parts.filter(d=>d.on).map(d=>d.f),path,zoom,w,h});
  });
}
const back=document.getElementById('mapBack');
back.addEventListener('click',()=>{const m=mapState; m.svg.transition().duration(700).call(m.zoom.transform,d3.zoomIdentity); m.g.selectAll('.country').classed('sel',false); back.hidden=true; worldPanel();});
function zoomTo(id){
  const m=mapState; const c=TRAVEL.find(t=>t.id===id); if(!m.ready||!c) return;
  const f=m.feats.find(x=>x.id===id); if(!f) return;
  const [[x0,y0],[x1,y1]]=m.path.bounds(f);
  const k=Math.min(160,0.75/Math.max((x1-x0)/m.w,(y1-y0)/m.h));
  const t=d3.zoomIdentity.translate(m.w/2,m.h/2).scale(k).translate(-(x0+x1)/2,-(y0+y1)/2);
  m.svg.transition().duration(800).call(m.zoom.transform,t);
  m.g.selectAll('.country').classed('sel',d=>d.on&&d.f.id===id);
  back.hidden=false; countryPanel(c);
}
initMap();
})();
</script>
